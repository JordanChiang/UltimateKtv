<Window x:Class="StyleSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StyleSimulator"
        Title="UltimateKTV 樣式與效果模擬器" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        FontSize="14"
        Background="#141419" Foreground="#EAEAEA">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAEAEA" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#22222D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#44445A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="14.5" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#22222D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#38384D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3F51B5" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button for ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#CCCCCC"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2D2D3B" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#5C5C7A" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2D2D3B" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#82B1FF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#22222D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#44445A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}"
                                          Grid.Column="2" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" />
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="9,5,28,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="6,3,26,3" Focusable="True" Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1C1C24"
                                            BorderThickness="1" BorderBrush="#44445A" CornerRadius="4" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#3F51B5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5C6BC0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="SuccessButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2E7D32" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#C62828" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#37474F" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#455A64" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="ResetButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E65100" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="13.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF6C00" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="CategoryNavButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#232332" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3A3A4C" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E2E42" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header & File Toolbar -->
            <RowDefinition Height="*" />    <!-- Main Split Area -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#0F0F14" BorderBrush="#22222E" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🎤" FontSize="24" Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="UltimateKTV 樣式與效果模擬器" FontSize="18" FontWeight="Bold" Foreground="#82B1FF" />                        
                    </StackPanel>
                </StackPanel>

                <!-- File Selector & Actions -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="目前編輯檔:" Foreground="#CCC" FontSize="14" Margin="0,0,6,0" />
                    <ComboBox x:Name="CboConfigFileType" Width="225" Margin="0,0,6,0" SelectionChanged="CboConfigFileType_SelectionChanged">
                        <ComboBoxItem Content="⚙️ settings.json (跑馬燈/提示)" IsSelected="True" />
                        <ComboBoxItem Content="🎨 textsettings.json (UI介面)" />
                    </ComboBox>
                    <TextBox x:Name="TxtActiveFilePath" Width="290" IsReadOnly="True" Margin="0,0,6,0" ToolTip="目前載入的設定檔路徑" />
                    <Button Content="📁 瀏覽..." Style="{StaticResource SecondaryButton}" Click="BtnBrowse_Click" Margin="0,0,6,0" />
                    <Button Content="🔄 重新載入" Style="{StaticResource SecondaryButton}" Click="BtnReload_Click" Margin="0,0,6,0" />
                    <Button Content="💾 儲存目前檔" Style="{StaticResource SuccessButton}" Click="BtnSaveCurrent_Click" Margin="0,0,6,0" />
                    <Button Content="💾 儲存全部 (雙檔)" Style="{StaticResource ActionButton}" Click="BtnSaveAll_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2">
                    <Button Content="⏹️ 停止動畫" Style="{StaticResource DangerButton}" Click="BtnStop_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="540" /> <!-- Left: Live Preview -->
                <ColumnDefinition Width="2*" MinWidth="440" /> <!-- Right: Dedicated Settings -->
            </Grid.ColumnDefinitions>

            <!-- Left: Dynamic View (Switches automatically based on selected file) -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Test Buttons Toolbar -->
                    <RowDefinition Height="*" />    <!-- Screen Canvas -->
                    <RowDefinition Height="Auto" /> <!-- Status Info -->
                </Grid.RowDefinitions>

                <!-- Top Quick Test Bar (Visible when settings.json is active) -->
                <Border x:Name="MarqueeTestBar" Grid.Row="0" Background="#1D1D27" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="⚡ 點擊跑馬燈進行模擬並檢視右側完整參數:" FontWeight="Bold" Margin="0,0,0,6" Foreground="#FFD54F" />
                        <WrapPanel>
                            <Button Content="🎵 播放跑馬燈 (1:有待播)" Style="{StaticResource ActionButton}" Click="BtnPlaySong1_Click" Margin="0,0,5,5" ToolTip="點擊模擬播放並在右側列出範本1完整參數" />
                            <Button Content="🎵 播放跑馬燈 (2:無待播)" Style="{StaticResource ActionButton}" Click="BtnPlaySong2_Click" Margin="0,0,5,5" ToolTip="點擊模擬播放並在右側列出範本2完整參數" />
                            <Button Content="🎲 隨機播放 (3)" Style="{StaticResource ActionButton}" Click="BtnPlaySong3_Click" Margin="0,0,5,5" ToolTip="點擊模擬播放並在右側列出範本3完整參數" />
                            <Button Content="🚀 啟動跑馬燈 (Startup)" Style="{StaticResource ActionButton}" Click="BtnPlayStartup_Click" Margin="0,0,5,5" ToolTip="點擊模擬播放並在右側列出啟動跑馬燈完整參數" />
                            <Button Content="✉️ 點播成功提示" Style="{StaticResource SuccessButton}" Click="BtnSongAdded_Click" Margin="0,0,5,5" ToolTip="點擊模擬顯示並在右側列出點播成功完整參數" />
                            <Button Content="🔊 系統廣播 (音量)" Style="{StaticResource ActionButton}" Click="BtnBroadcast_Click" Margin="0,0,5,5" ToolTip="點擊模擬顯示並在右側列出系統廣播完整參數" />
                            <Button Content="⚡ 佇列測試 (點歌+播放)" Style="{StaticResource SecondaryButton}" Click="BtnQueueTest_Click" Margin="0,0,5,5" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- UI Info Bar (Visible when textsettings.json is active) -->
                <Border x:Name="UiInfoBar" Grid.Row="0" Background="#1D1D27" CornerRadius="6" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎨 點歌機操作介面 (UI 樣式與排版模擬)" FontWeight="Bold" Foreground="#82B1FF" VerticalAlignment="Center" />
                        <TextBlock Text="（調整右側字級與顏色立即反映於下方介面）" Foreground="#AAA" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Dynamic Preview Container -->
                <Grid Grid.Row="1">
                    <!-- VIEW 1: 16:9 播放螢幕 (Player Stage Screen for settings.json) -->
                    <Border x:Name="PlayerScreenView" Background="#06060A" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="8" ClipToBounds="True" Padding="6">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="1920" Height="1080" Background="#050508" BorderBrush="#FFFFFF" BorderThickness="3" CornerRadius="4">
                                <Grid ClipToBounds="True">
                                    <!-- Background Stage Ambient & Watermark -->
                                    <Rectangle Fill="#08080E" />
                                    <Ellipse Width="1200" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.22">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#3F51B5" Offset="0" />
                                                <GradientStop Color="#1A237E" Offset="0.5" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8">
                                        <TextBlock Text="📺 電視播放螢幕模擬" HorizontalAlignment="Center" Foreground="#9FA8DA" FontSize="42" FontWeight="Bold" Margin="0,0,0,12" />
                                        <TextBlock Text="標準 16:9 比例 (1920 × 1080 Full HD)" HorizontalAlignment="Center" Foreground="#7986CB" FontSize="26" />
                                    </StackPanel>

                                    <!-- 1920x1080 Marquee Canvas -->
                                    <Canvas x:Name="MarqueeCanvas" Width="1920" Height="1080" ClipToBounds="True" />
                                </Grid>
                            </Border>
                        </Viewbox>
                    </Border>

                    <!-- VIEW 2: 點歌機操作介面 (KTV UI View for textsettings.json) -->
                    <Border x:Name="KtvUiView" Background="#101017" BorderBrush="#2F2F3F" BorderThickness="2" CornerRadius="8" Padding="8" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- Top Header Announcement -->
                                <RowDefinition Height="*" />    <!-- Middle Table & Waiting List -->
                                <RowDefinition Height="Auto" /> <!-- Bottom Action Buttons -->
                            </Grid.RowDefinitions>

                            <!-- Announcement Header -->
                            <Border Grid.Row="0" x:Name="BorderHeader" Background="#1A1A24" BorderBrush="#FFC107" BorderThickness="0,0,0,2" Padding="10,8" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtPreviewAnnouncement" Text="📢 [系統公告] 歡迎光臨 Ultimate KTV 歡唱系統！" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <TextBlock x:Name="TxtPreviewStatic" Grid.Column="1" Text="網路點歌: 192.168.1.100:8080" FontSize="14" Foreground="#82B1FF" />
                                </Grid>
                            </Border>

                            <!-- Middle Section -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <!-- Song List Table -->
                                <Border Grid.Column="0" x:Name="BorderSongList" Background="#161620" BorderBrush="#FFD700" BorderThickness="1" CornerRadius="4" Margin="0,0,6,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <!-- Header -->
                                        <Border Grid.Row="0" x:Name="BorderGridHeader" Background="#FF4A4A4A" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="70" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="編號" FontWeight="Bold" Foreground="#FFFFFF" />
                                                <TextBlock Grid.Column="1" Text="歌名" FontWeight="Bold" Foreground="#FFFFFF" />
                                                <TextBlock Grid.Column="2" Text="歌手" FontWeight="Bold" Foreground="#FFFFFF" />
                                                <TextBlock Grid.Column="3" Text="字數" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Grid>
                                        </Border>
                                        <!-- Rows -->
                                        <StackPanel Grid.Row="1" Margin="8,6">
                                            <TextBlock x:Name="TxtSongRow1" Text="001. 晴天 - 周杰倫 (2字)" Margin="0,4" Foreground="#FFFFFF" />
                                            <TextBlock x:Name="TxtSongRow2" Text="002. 告白氣球 - 周杰倫 (4字)" Margin="0,4" Foreground="#DDD" />
                                            <TextBlock x:Name="TxtSongRow3" Text="003. 稻香 - 周杰倫 (2字)" Margin="0,4" Foreground="#DDD" />
                                            <TextBlock x:Name="TxtSongRow4" Text="004. 青花瓷 - 周杰倫 (3字)" Margin="0,4" Foreground="#DDD" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Waiting List -->
                                <Border Grid.Column="1" Background="#161620" BorderBrush="#353545" BorderThickness="1" CornerRadius="4" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="📋 待播清單" FontWeight="Bold" Foreground="#FFD54F" Margin="0,0,0,6" />
                                        <TextBlock x:Name="TxtWaitRow1" Text="1. 晴天 (播放中)" Foreground="#81C784" Margin="0,3" />
                                        <TextBlock x:Name="TxtWaitRow2" Text="2. 告白氣球" Foreground="#CCC" Margin="0,3" />
                                        <TextBlock x:Name="TxtWaitRow3" Text="3. 稻香" Foreground="#CCC" Margin="0,3" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bottom Buttons -->
                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <WrapPanel Grid.Row="0" Margin="0,0,0,6">
                                    <Button x:Name="BtnFunc1" Content="🎤 國語點歌" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Padding="12,6" />
                                    <Button x:Name="BtnFunc2" Content="🎵 台語點歌" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Padding="12,6" />
                                    <Button x:Name="BtnFunc3" Content="🌏 粵語點歌" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Padding="12,6" />
                                    <Button x:Name="BtnFunc4" Content="⭐ 我的最愛" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Padding="12,6" />
                                </WrapPanel>
                                <WrapPanel Grid.Row="1">
                                    <Button x:Name="BtnBottom1" Content="⏭️ 切歌" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="14,6" />
                                    <Button x:Name="BtnBottom2" Content="⏸️ 暫停" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="14,6" />
                                    <Button x:Name="BtnBottom3" Content="🔁 重播" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="14,6" />
                                    <Button x:Name="BtnBottom4" Content="🔊 音量 +" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="14,6" />
                                </WrapPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Status Bar Below Screen -->
                <Border Grid.Row="2" Background="#121218" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtSimStatus" Text="狀態: 就緒" Foreground="#81C784" />
                        <TextBlock x:Name="TxtAnimInfo" Grid.Column="1" Text="" Foreground="#AAA" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Right: Settings Panel Container -->
            <Border Grid.Column="1" Background="#1B1B24" CornerRadius="8" Padding="10">
                <Grid>
                    <!-- PANEL 1: settings.json 跑馬燈專屬設定 -->
                    <Grid x:Name="SettingsJsonGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /> <!-- Header & Reset -->
                            <RowDefinition Height="Auto" /> <!-- Category Selector Bar -->
                            <RowDefinition Height="*" />    <!-- Dedicated Category Form -->
                        </Grid.RowDefinitions>

                        <!-- Header with Reset Button -->
                        <Border Grid.Row="0" Background="#242432" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="⚙️ settings.json 跑馬燈與提示參數" FontWeight="Bold" Foreground="#FFD54F" />
                                <Button Content="🔄 回復預設值" HorizontalAlignment="Right" Style="{StaticResource ResetButton}" Click="BtnResetSettingsDefaults_Click" ToolTip="將所有跑馬燈與提示參數重設為原廠預設值" />
                            </Grid>
                        </Border>

                        <!-- Category Selector Bar -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <Button x:Name="BtnNavPlayback" Content="🎵 跑馬燈設定 (含啟動/播放)" Style="{StaticResource CategoryNavButton}" Click="BtnNavPlayback_Click" Margin="0,0,5,5" />
                            <Button x:Name="BtnNavSongAdded" Content="✉️ 點播成功提示" Style="{StaticResource CategoryNavButton}" Click="BtnNavSongAdded_Click" Margin="0,0,5,5" />
                            <Button x:Name="BtnNavBroadcast" Content="📢 系統廣播" Style="{StaticResource CategoryNavButton}" Click="BtnNavBroadcast_Click" Margin="0,0,5,5" />
                            <Button x:Name="BtnNavMockData" Content="🛠️ 模擬資料" Style="{StaticResource CategoryNavButton}" Click="BtnNavMockData_Click" Margin="0,0,5,5" />
                        </WrapPanel>

                        <!-- Form Scroll Area -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                            <StackPanel Margin="0,0,8,0">

                                <!-- CARD 1: 跑馬燈設定 (播放 & 啟動共用) -->
                                <StackPanel x:Name="CardPlayback">
                                    <Border Background="#232332" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="🎵 跑馬燈外觀與文字設定 (啟動/播放共用)" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Border>

                                    <!-- Font Family -->
                                    <TextBlock Text="文字字型 (FontFamily):" FontWeight="SemiBold" Margin="0,2,0,2" />
                                    <ComboBox x:Name="CboFontFamily" DisplayMemberPath="DisplayName" SelectionChanged="ParamChanged" Margin="0,0,0,6" />

                                    <!-- 2 Colors Side by Side -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Fill Color -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="文字填滿顏色 (點色塊選色):" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtFillColor" TextChanged="ParamChanged" />
                                                <Border x:Name="RectFillColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectFillColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Stroke Color -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="文字描邊顏色 (點色塊選色):" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtStrokeColor" TextChanged="ParamChanged" />
                                                <Border x:Name="RectStrokeColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectStrokeColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 6 參數集中 3 行左右併排 -->
                                    <Grid Margin="0,2,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- ROW 1 Left: 字體粗細 -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                            <TextBlock Text="字體粗細 (FontWeight):" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboFontWeight" SelectionChanged="ParamChanged" />
                                        </StackPanel>

                                        <!-- ROW 1 Right: 字體大小 -->
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="字體大小 (12 ~ 128 像素):" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LblFontSize" HorizontalAlignment="Right" Text="72 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                            </Grid>
                                            <Slider x:Name="SldFontSize" Minimum="12" Maximum="128" Value="72" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />
                                        </StackPanel>

                                        <!-- ROW 2 Left: 文字描邊 -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="文字描邊 (0 ~ 32 像素):" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LblStrokeThickness" HorizontalAlignment="Right" Text="8 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                            </Grid>
                                            <Slider x:Name="SldStrokeThickness" Minimum="0" Maximum="32" Value="8" ValueChanged="ParamChanged" />
                                        </StackPanel>

                                        <!-- ROW 2 Right: 滾動速度 -->
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="滾動速度 (100 ~ 1000 像素/秒):" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LblSpeed" HorizontalAlignment="Right" Text="200 像素/秒" FontWeight="Bold" Foreground="#82B1FF" />
                                            </Grid>
                                            <Slider x:Name="SldSpeed" Minimum="100" Maximum="1000" Value="200" TickFrequency="100" IsSnapToTickEnabled="True" SmallChange="100" LargeChange="100" ValueChanged="ParamChanged" />
                                        </StackPanel>

                                        <!-- ROW 3 Left: 間隔時間 -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="間隔時間 (0 ~ 5 秒):" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LblHoldTime" HorizontalAlignment="Right" Text="1 秒" FontWeight="Bold" Foreground="#82B1FF" />
                                            </Grid>
                                            <Slider x:Name="SldHoldTime" Minimum="0" Maximum="5" Value="1" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1" ValueChanged="ParamChanged" />
                                        </StackPanel>

                                        <!-- ROW 3 Right: 重覆次數 -->
                                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock Text="重覆次數 (0 ~ 10 次, 0=關閉):" FontWeight="SemiBold" />
                                                <TextBlock x:Name="LblPlayCount" HorizontalAlignment="Right" Text="2 次" FontWeight="Bold" Foreground="#82B1FF" />
                                            </Grid>
                                            <Slider x:Name="SldPlayCount" Minimum="0" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1" ValueChanged="ParamChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Separator Background="#353545" Margin="0,4,0,6" />

                                    <TextBlock Text="範本 1 (有待播歌曲 - MarqueeTextString1):" FontWeight="SemiBold" Margin="0,2,0,2" />
                                    <TextBox x:Name="TxtTemplate1" TextWrapping="Wrap" Height="42" Padding="6,0" TextAlignment="Left" VerticalContentAlignment="Center" TextChanged="ParamChanged" />

                                    <TextBlock Text="範本 2 (無待播歌曲 - MarqueeTextString2):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <TextBox x:Name="TxtTemplate2" TextWrapping="Wrap" Height="42" Padding="6,0" TextAlignment="Left" VerticalContentAlignment="Center" TextChanged="ParamChanged" />

                                    <TextBlock Text="範本 3 (隨機播放無待播 - MarqueeTextString3):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <TextBox x:Name="TxtTemplate3" TextWrapping="Wrap" Height="42" Padding="6,0" TextAlignment="Left" VerticalContentAlignment="Center" TextChanged="ParamChanged" />

                                    <TextBlock Text="啟動跑馬燈範本 (進入程式時 - MarqueeTextStartup):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <TextBox x:Name="TxtTemplateStartup" TextWrapping="Wrap" Height="42" Padding="6,0" TextAlignment="Left" VerticalContentAlignment="Center" TextChanged="ParamChanged" />

                                    <TextBlock Text="參數: {0}=歌名, {1}=歌手, {2}=下首歌名, {3}=下首歌手, {4}=區網網址, {5}=外網網址, {6}=點歌人" Foreground="#FFD54F" FontSize="13.5" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- CARD 2: 點播成功提示 -->
                                <StackPanel x:Name="CardSongAdded" Visibility="Collapsed">
                                    <Border Background="#232332" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                        <TextBlock Text="✉️ 點播成功提示設定" FontWeight="Bold" FontSize="15" Foreground="#82B1FF" />
                                    </Border>
                                    <TextBlock Text="點播成功文字範本 (MarqueeSongAddedString):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <TextBox x:Name="TxtSongAddedTemplate" TextWrapping="Wrap" Height="42" Padding="6,0" TextAlignment="Left" VerticalContentAlignment="Center" TextChanged="ParamChanged" />
                                    <TextBlock Text="參數: {0}=歌名, {1}=歌手, {4}=區網網址, {5}=外網網址, {6}=點歌人" Foreground="#FFD54F" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,8" TextWrapping="Wrap" />

                                    <TextBlock Text="點播成功字型 (FontFamily):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <ComboBox x:Name="CboSongAddedFontFamily" DisplayMemberPath="DisplayName" SelectionChanged="ParamChanged" />

                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="字體大小 (12 ~ 128 像素):" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LblSongAddedFontSize" Grid.Column="1" Text="48 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Grid>
                                    <Slider x:Name="SldSongAddedFontSize" Minimum="12" Maximum="128" Value="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                    <TextBlock Text="文字顏色 (點擊色塊開啟調色盤):" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSongAddedFillColor" TextChanged="ParamChanged" />
                                        <Border x:Name="RectSongAddedFillColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectSongAddedFillColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                    </Grid>

                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="顯示時間 (0 ~ 60 秒, 0=關閉):" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LblSongAddedDuration" Grid.Column="1" Text="3 秒" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Grid>
                                    <Slider x:Name="SldSongAddedDuration" Minimum="0" Maximum="60" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />
                                </StackPanel>

                                <!-- CARD 4: 系統廣播 -->
                                <StackPanel x:Name="CardBroadcast" Visibility="Collapsed">
                                    <Border Background="#232332" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="📢 系統廣播設定 (音量/音調等)" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Border>
                                    <TextBlock Text="系統廣播字型 (FontFamily):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <ComboBox x:Name="CboBroadcastFontFamily" DisplayMemberPath="DisplayName" SelectionChanged="ParamChanged" />

                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="廣播字體大小 (12 ~ 128 像素):" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LblBroadcastFontSize" Grid.Column="1" Text="48 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Grid>
                                    <Slider x:Name="SldBroadcastFontSize" Minimum="12" Maximum="128" Value="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                    <TextBlock Text="廣播文字顏色 (點擊色塊開啟調色盤):" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtBroadcastFillColor" TextChanged="ParamChanged" />
                                        <Border x:Name="RectBroadcastFillColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectBroadcastFillColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                    </Grid>

                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="廣播顯示時間 (0 ~ 60 秒, 0=關閉):" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LblBroadcastDuration" Grid.Column="1" Text="3 秒" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Grid>
                                    <Slider x:Name="SldBroadcastDuration" Minimum="0" Maximum="60" Value="3" ValueChanged="ParamChanged" />
                                </StackPanel>

                                <!-- CARD 5: 模擬資料 -->
                                <StackPanel x:Name="CardMockData" Visibility="Collapsed">
                                    <Border Background="#232332" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="🛠️ 模擬測試資料" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Border>
                                    <TextBlock Text="當前歌名 {0}:" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <TextBox x:Name="TxtMockSong" Text="晴天" TextChanged="ParamChanged" />

                                    <TextBlock Text="當前歌手 {1}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockSinger" Text="周杰倫" TextChanged="ParamChanged" />

                                    <TextBlock Text="下首歌名 {2}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockNextSong" Text="再見" TextChanged="ParamChanged" />

                                    <TextBlock Text="下首歌手 {3}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockNextSinger" Text="鄧紫棋" TextChanged="ParamChanged" />

                                    <TextBlock Text="區網 IP:Port {4}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockLanIp" Text="192.168.1.100:8080" TextChanged="ParamChanged" />

                                    <TextBlock Text="外網 IP:Port {5}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockWanIp" Text="220.222.1.1:8080" TextChanged="ParamChanged" />

                                    <TextBlock Text="網路點歌人 {6}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockOrderedBy" Text="UltimateKTV" TextChanged="ParamChanged" />
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- PANEL 2: textsettings.json UI 專屬設定面板 -->
                    <Grid x:Name="TextSettingsGrid" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header with Reset Button -->
                        <Border Grid.Row="0" Background="#242432" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="🎨 textsettings.json 點歌機介面字級與配色" FontWeight="Bold" Foreground="#82B1FF" />
                                <Button Content="🔄 回復預設值" HorizontalAlignment="Right" Style="{StaticResource ResetButton}" Click="BtnResetTextSettingsDefaults_Click" ToolTip="將點歌機介面所有字體與色彩重設為原廠預設值" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="點歌機全域字型 (FontFamily):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <ComboBox x:Name="CboUiFontFamily" DisplayMemberPath="DisplayName" SelectionChanged="ParamChanged" />

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="歌曲清單字體大小 (SongListFontSize):" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LblSongListFontSize" Grid.Column="1" Text="38 px" FontWeight="Bold" Foreground="#82B1FF" />
                                </Grid>
                                <Slider x:Name="SldSongListFontSize" Minimum="16" Maximum="72" Value="38" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="待播清單字體大小 (WaitingListFontSize):" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LblWaitingListFontSize" Grid.Column="1" Text="24 px" FontWeight="Bold" Foreground="#82B1FF" />
                                </Grid>
                                <Slider x:Name="SldWaitingListFontSize" Minimum="12" Maximum="60" Value="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="功能按鈕字體大小 (FuncBtnFontSize):" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LblFuncBtnFontSize" Grid.Column="1" Text="32 px" FontWeight="Bold" Foreground="#82B1FF" />
                                </Grid>
                                <Slider x:Name="SldFuncBtnFontSize" Minimum="14" Maximum="64" Value="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="底部按鈕字體大小 (BottomButtonFontSize):" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LblBottomButtonFontSize" Grid.Column="1" Text="36 px" FontWeight="Bold" Foreground="#82B1FF" />
                                </Grid>
                                <Slider x:Name="SldBottomButtonFontSize" Minimum="14" Maximum="64" Value="36" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="網路主機資訊字體大小 (WebHostInfoFontSize):" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LblWebHostInfoFontSize" Grid.Column="1" Text="32 px" FontWeight="Bold" Foreground="#82B1FF" />
                                </Grid>
                                <Slider x:Name="SldWebHostInfoFontSize" Minimum="12" Maximum="60" Value="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                <Separator Background="#353545" Margin="0,10" />

                                <!-- Primary Color -->
                                <TextBlock Text="主色調 (點擊色塊開啟調色盤):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPrimaryColor" Text="#FFC107" TextChanged="ParamChanged" />
                                    <Border x:Name="RectPrimaryColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectPrimaryColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>

                                <!-- Bright Border Color -->
                                <TextBlock Text="亮邊框顏色 (點擊色塊開啟調色盤):" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtBrightBorderColor" Text="#FFD700" TextChanged="ParamChanged" />
                                    <Border x:Name="RectBrightBorderColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectBrightBorderColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>

                                <!-- DataGrid Header Bg -->
                                <TextBlock Text="表格標題背景色 (點擊色塊開啟調色盤):" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDataGridHeaderBg" Text="#FF4A4A4A" TextChanged="ParamChanged" />
                                    <Border x:Name="RectDataGridHeaderBg" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectDataGridHeaderBg_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>

                                <!-- Announcement Foreground -->
                                <TextBlock Text="公告文字顏色 (點擊色塊開啟調色盤):" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAnnouncementFg" Text="#FFFFFF" TextChanged="ParamChanged" />
                                    <Border x:Name="RectAnnouncementFg" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectAnnouncementFg_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#0C0C11" BorderBrush="#1C1C24" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock Text="💡 提示: 點擊上方跑馬燈按鈕會自動切換右側參數分頁；點擊色彩方塊可直接叫出調色盤選色。" Foreground="#9FA8DA" FontSize="13" />
        </StatusBar>
    </Grid>
</Window>
