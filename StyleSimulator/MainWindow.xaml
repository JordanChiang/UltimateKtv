                </Border>

                <!-- Dynamic Preview Container -->
                <Grid Grid.Row="1">
                    <!-- VIEW 1: 16:9 播放螢幕 (Player Stage Screen for settings.json) -->
                    <Border x:Name="PlayerScreenView" Background="#06060A" BorderBrush="#FFFFFF" BorderThickness="2" CornerRadius="8" ClipToBounds="True" Padding="6">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="1920" Height="1080" Background="#050508" BorderBrush="#FFFFFF" BorderThickness="3" CornerRadius="4">
                                <Grid ClipToBounds="True">
                                    <!-- Background Stage Ambient & Watermark -->
                                    <Rectangle Fill="#08080E" />
                                    <Ellipse Width="1200" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.22">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#3F51B5" Offset="0" />
                                                <GradientStop Color="#1A237E" Offset="0.5" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8">
                                        <TextBlock Text="📺 電視播放螢幕模擬" HorizontalAlignment="Center" Foreground="#9FA8DA" FontSize="42" FontWeight="Bold" Margin="0,0,0,12" />
                                        <TextBlock Text="標準 16:9 比例 (1920 × 1080 Full HD)" HorizontalAlignment="Center" Foreground="#7986CB" FontSize="26" />
                                    </StackPanel>

                                    <!-- 1920x1080 Marquee Canvas -->
                                    <Canvas x:Name="MarqueeCanvas" Width="1920" Height="1080" ClipToBounds="True" />
                                </Grid>
                            </Border>
                        </Viewbox>
                    </Border>

                    <!-- VIEW 2: 點歌機操作介面 (KTV UI View for textsettings.json - 1920x1080 Viewbox) -->
                    <Border x:Name="KtvUiView" Background="#0A0A0E" BorderBrush="#333344" BorderThickness="2" CornerRadius="8" ClipToBounds="True" Padding="6" Visibility="Collapsed">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="BorderKtvFrame" Width="1920" Height="1080" Background="#1E1E1E" SnapsToDevicePixels="True" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" CornerRadius="4" ToolTip="由 [PrimaryColor] 主要主題色控制">
                                <Grid Margin="10,8,10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /> <!-- Marquee / Announcement banner -->
                                        <RowDefinition Height="*" />    <!-- Main Content: Left & Right Panels -->
                                    </Grid.RowDefinitions>

                                    <!-- Announcement & Host Info Banner (Reflects PrimaryColor, AnnouncementForegroundColor, WebHostInfoForegroundColor, StaticTextForegroundColor) -->
                                    <Border Grid.Row="0" x:Name="BorderHeader" Background="#141414" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="0,0,0,2" Padding="14,6" Margin="0,0,0,8" ToolTip="下邊框由 [PrimaryColor] 主要主題色控制">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtPreviewAnnouncement" Text="📢 [系統公告] 歡迎光臨 Ultimate KTV 歡唱系統！" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AnnouncementFgBrush}" VerticalAlignment="Center" ToolTip="由 [AnnouncementForegroundColor] 系統公告前景色控制" />
                                            <TextBlock x:Name="TxtPreviewWebHostInfo" Grid.Column="1" Text="🌐 遠端點歌: http://192.168.1.100:8080" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource WebHostInfoFgBrush}" VerticalAlignment="Center" Margin="24,0" ToolTip="由 [WebHostInfoForegroundColor] 網路主機資訊前景色控制" />
                                            <TextBlock x:Name="TxtPreviewStaticText" Grid.Column="2" Text="📌 提示: 點擊歌曲即可預約；長按可優先插播" FontSize="20" Foreground="{DynamicResource StaticTextFgBrush}" VerticalAlignment="Center" ToolTip="由 [StaticTextForegroundColor] 靜態文字前景色控制" />
                                        </Grid>
                                    </Border>

                                    <!-- Main Content Area: Left Panel (406px) + Right Panel (*) -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="406" /> <!-- Left Panel -->
                                            <ColumnDefinition Width="10" />  <!-- Separator -->
                                            <ColumnDefinition Width="*" />   <!-- Right Panel -->
                                        </Grid.ColumnDefinitions>

                                        <!-- ==================== LEFT PANEL ==================== -->
                                        <DockPanel Grid.Column="0">
                                            <!-- Top Function Buttons (2 rows x 4 cols with 8px spacing) -->
                                            <Border DockPanel.Dock="Top" Margin="0,0,0,10">
                                                <StackPanel Margin="0">
                                                    <!-- Row 1 -->
                                                    <UniformGrid Rows="1" Margin="0,0,0,8">
                                                        <Button x:Name="FuncBtn1" Content="歌星" Style="{StaticResource FunctionButtonStyle}" />
                                                        <Button x:Name="FuncBtn2" Content="最愛" Style="{StaticResource FunctionButtonStyle}" />
                                                        <Button x:Name="FuncBtn3" Content="編號" Style="{StaticResource FunctionButtonStyle}" />
                                                        <Button x:Name="FuncBtn4" Content="語系" Style="{StaticResource FunctionButtonStyle}" />
                                                    </UniformGrid>
                                                    <!-- Row 2 -->
                                                    <UniformGrid Rows="1">
                                                        <Button x:Name="FuncBtn5" Content="新進" Style="{StaticResource FunctionButtonStyle}" />
                                                        <Button x:Name="FuncBtn6" Content="排行" Style="{StaticResource FunctionButtonStyle}" />
                                                        <Button x:Name="FuncBtn7" Content="搜尋" Style="{StaticResource FunctionButtonStyle}" />
                                                        <Button x:Name="FuncBtn8" Content="設定" Style="{StaticResource FunctionButtonStyle}" />
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Bottom Player Controls (Cut Song + 2x2 buttons) -->
                                            <Border DockPanel.Dock="Bottom" Height="110" Margin="0,10,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="122" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Large SkipSong Button -->
                                                    <Button x:Name="BtnSkipSong" Content="切歌" Grid.Column="0" Style="{StaticResource LargePlayerControlButtonStyle}" />

                                                    <!-- 2x2 Controls: Pause, Repeat / Vocal, Music -->
                                                    <Grid Grid.Column="2">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="5" />
                                                            <RowDefinition Height="*" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="8" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="BtnPause" Content="暫停" Grid.Row="0" Grid.Column="0" Style="{StaticResource PlayerControlButtonStyle}" />
                                                        <Button x:Name="BtnRepeat" Content="重播" Grid.Row="0" Grid.Column="2" Style="{StaticResource SubmenuPlayerControlButtonStyle}" />
                                                        <Button x:Name="BtnVocal" Content="人聲" Grid.Row="2" Grid.Column="0" Style="{StaticResource SubmenuPlayerControlButtonStyle}" />
                                                        <Button x:Name="BtnMusic" Content="伴唱" Grid.Row="2" Grid.Column="2" Style="{StaticResource PlayerControlButtonStyle}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- Center: Waiting List (Height 444) + Mini Video Player -->
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="444" /> <!-- Waiting List DataGrid + Pagination -->
                                                    <RowDefinition Height="*" />   <!-- Mini Video Player -->
                                                </Grid.RowDefinitions>

                                                <!-- Waiting List -->
                                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" /> <!-- Table with Header & Rows -->
                                                        <RowDefinition Height="Auto" /> <!-- Pagination -->
                                                    </Grid.RowDefinitions>

                                                    <!-- Waiting List Frame (PrimaryColor) -->
                                                    <Border Grid.Row="0" x:Name="BorderWaitList" Background="#121212" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1.5" CornerRadius="4" ClipToBounds="True" ToolTip="由 [PrimaryColor] 主要主題色控制">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" MinHeight="45" />   <!-- Header -->
                                                                <RowDefinition Height="396" />  <!-- 8 Waiting Rows Area -->
                                                            </Grid.RowDefinitions>

                                                            <!-- Waiting List Header (Matches screenshot) -->
                                                            <Border Grid.Row="0" x:Name="BorderWaitHeader" Background="{DynamicResource DataGridHeaderBgBrush}" BorderThickness="0" Padding="0,2" Margin="8,2,8,2" CornerRadius="8" ToolTip="由 [DataGridColumnHeaderBackgroundColor] 表格標題背景色控制">
                                                                <Grid VerticalAlignment="Center">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="260" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock x:Name="TxtWaitHeaderCol1" Text="歌名" FontWeight="Bold" FontSize="24" Foreground="{DynamicResource DataGridHeaderFgBrush}" VerticalAlignment="Center" Margin="16,0" ToolTip="由 [DataGridColumnHeaderForegroundColor] 表格標題文字色控制" />
                                                                    <Border Grid.Column="0" HorizontalAlignment="Right" Width="1" Background="#33FFFFFF" Margin="0,8" />
                                                                    <TextBlock x:Name="TxtWaitHeaderCol2" Grid.Column="1" Text="歌手" FontWeight="Bold" FontSize="24" Foreground="{DynamicResource DataGridHeaderFgBrush}" VerticalAlignment="Center" Margin="16,0" ToolTip="由 [DataGridColumnHeaderForegroundColor] 表格標題文字色控制" />
                                                                </Grid>
                                                            </Border>

                                                            <!-- Waiting List 8 Rows (Alternating dark rows, matching WPF DataGrid, -1 for card style height) -->
                                                            <UniformGrid Grid.Row="1" Rows="8" Columns="1">
                                                                <!-- Row 1 -->
                                                                <Border x:Name="BorderWaitRow1" CornerRadius="8" Margin="8,1.5" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#181B24" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Border x:Name="InnerGlowWaitRow1" Margin="1" CornerRadius="7" BorderThickness="3.5" BorderBrush="Transparent" Background="Transparent" IsHitTestVisible="False">
                                                                            <Border.Effect>
                                                                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Quality"/>
                                                                            </Border.Effect>
                                                                        </Border>
                                                                        <Border x:Name="AccentBarWaitRow1" Width="16" HorizontalAlignment="Left" CornerRadius="7,0,0,7" Background="#3300F0FF" Visibility="Collapsed" />
                                                                        <Grid VerticalAlignment="Center" Margin="16,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="260" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock x:Name="TxtWaitSong1" Text="倒帶" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock x:Name="TxtWaitSinger1" Grid.Column="1" Text="蔡依林" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Row 2 -->
                                                                <Border x:Name="BorderWaitRow2" CornerRadius="8" Margin="8,1.5" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#141720" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Border x:Name="InnerGlowWaitRow2" Margin="1" CornerRadius="7" BorderThickness="3.5" BorderBrush="Transparent" Background="Transparent" IsHitTestVisible="False">
                                                                            <Border.Effect>
                                                                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Quality"/>
                                                                            </Border.Effect>
                                                                        </Border>
                                                                        <Border x:Name="AccentBarWaitRow2" Width="16" HorizontalAlignment="Left" CornerRadius="7,0,0,7" Background="#3300F0FF" Visibility="Collapsed" />
                                                                        <Grid VerticalAlignment="Center" Margin="16,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="260" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock x:Name="TxtWaitSong2" Text="告白氣球" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock x:Name="TxtWaitSinger2" Grid.Column="1" Text="周杰倫" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Row 3 -->
                                                                <Border x:Name="BorderWaitRow3" CornerRadius="8" Margin="8,1.5" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#141720" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Border x:Name="InnerGlowWaitRow3" Margin="1" CornerRadius="7" BorderThickness="3.5" BorderBrush="Transparent" Background="Transparent" IsHitTestVisible="False">
                                                                            <Border.Effect>
                                                                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Quality"/>
                                                                            </Border.Effect>
                                                                        </Border>
                                                                        <Border x:Name="AccentBarWaitRow3" Width="16" HorizontalAlignment="Left" CornerRadius="7,0,0,7" Background="#3300F0FF" Visibility="Collapsed" />
                                                                        <Grid VerticalAlignment="Center" Margin="16,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="260" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock x:Name="TxtWaitSong3" Text="修煉愛情" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock x:Name="TxtWaitSinger3" Grid.Column="1" Text="林俊傑" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Row 4 -->
                                                                <Border x:Name="BorderWaitRow4" CornerRadius="8" Margin="8,1.5" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#181B24" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Border x:Name="InnerGlowWaitRow4" Margin="1" CornerRadius="7" BorderThickness="3.5" BorderBrush="Transparent" Background="Transparent" IsHitTestVisible="False">
                                                                            <Border.Effect>
                                                                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Quality"/>
                                                                            </Border.Effect>
                                                                        </Border>
                                                                        <Border x:Name="AccentBarWaitRow4" Width="16" HorizontalAlignment="Left" CornerRadius="7,0,0,7" Background="#3300F0FF" Visibility="Collapsed" />
                                                                        <Grid VerticalAlignment="Center" Margin="16,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="260" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock x:Name="TxtWaitSong4" Text="" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock x:Name="TxtWaitSinger4" Grid.Column="1" Text="" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Row 5 -->
                                                                <Border x:Name="BorderWaitRow5" CornerRadius="8" Margin="8,1.5" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#141720" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Border x:Name="InnerGlowWaitRow5" Margin="1" CornerRadius="7" BorderThickness="3.5" BorderBrush="Transparent" Background="Transparent" IsHitTestVisible="False">
                                                                            <Border.Effect>
                                                                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Quality"/>
                                                                            </Border.Effect>
                                                                        </Border>
                                                                        <Border x:Name="AccentBarWaitRow5" Width="16" HorizontalAlignment="Left" CornerRadius="7,0,0,7" Background="#3300F0FF" Visibility="Collapsed" />
                                                                        <Grid VerticalAlignment="Center" Margin="16,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="260" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock x:Name="TxtWaitSong5" Text="" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock x:Name="TxtWaitSinger5" Grid.Column="1" Text="" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Row 6 -->
                                                                <Border x:Name="BorderWaitRow6" CornerRadius="8" Margin="8,1.5" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#181B24" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Border x:Name="InnerGlowWaitRow6" Margin="1" CornerRadius="7" BorderThickness="3.5" BorderBrush="Transparent" Background="Transparent" IsHitTestVisible="False">
                                                                            <Border.Effect>
                                                                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Quality"/>
                                                                            </Border.Effect>
                                                                        </Border>
                                                                        <Border x:Name="AccentBarWaitRow6" Width="16" HorizontalAlignment="Left" CornerRadius="7,0,0,7" Background="#3300F0FF" Visibility="Collapsed" />
                                                                        <Grid VerticalAlignment="Center" Margin="16,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="260" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock x:Name="TxtWaitSong6" Text="" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock x:Name="TxtWaitSinger6" Grid.Column="1" Text="" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Row 7 -->
                                                                <Border x:Name="BorderWaitRow7" CornerRadius="8" Margin="8,1.5" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#141720" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Border x:Name="InnerGlowWaitRow7" Margin="1" CornerRadius="7" BorderThickness="3.5" BorderBrush="Transparent" Background="Transparent" IsHitTestVisible="False">
                                                                            <Border.Effect>
                                                                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Quality"/>
                                                                            </Border.Effect>
                                                                        </Border>
                                                                        <Border x:Name="AccentBarWaitRow7" Width="16" HorizontalAlignment="Left" CornerRadius="7,0,0,7" Background="#3300F0FF" Visibility="Collapsed" />
                                                                        <Grid VerticalAlignment="Center" Margin="16,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="260" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock x:Name="TxtWaitSong7" Text="" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock x:Name="TxtWaitSinger7" Grid.Column="1" Text="" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                                <!-- Row 8 -->
                                                                <Border x:Name="BorderWaitRow8" CornerRadius="8" Margin="8,1.5" BorderThickness="1" BorderBrush="#20FFFFFF" Background="#181B24" ClipToBounds="True">
                                                                    <Grid>
                                                                        <Border x:Name="InnerGlowWaitRow8" Margin="1" CornerRadius="7" BorderThickness="3.5" BorderBrush="Transparent" Background="Transparent" IsHitTestVisible="False">
                                                                            <Border.Effect>
                                                                                <BlurEffect Radius="8" KernelType="Gaussian" RenderingBias="Quality"/>
                                                                            </Border.Effect>
                                                                        </Border>
                                                                        <Border x:Name="AccentBarWaitRow8" Width="16" HorizontalAlignment="Left" CornerRadius="7,0,0,7" Background="#3300F0FF" Visibility="Collapsed" />
                                                                        <Grid VerticalAlignment="Center" Margin="16,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="260" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock x:Name="TxtWaitSong8" Text="" Foreground="#FFFFFF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock x:Name="TxtWaitSinger8" Grid.Column="1" Text="" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                                                                        </Grid>
                                                                    </Grid>
                                                                </Border>
                                                            </UniformGrid>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Waiting List Pagination (Matches screenshot) -->
                                                    <Grid Grid.Row="1" Margin="2,8,2,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="TxtWaitPageInfo" Text="第 1/1 頁&#x0a;(3 首歌曲)" VerticalAlignment="Center" Foreground="{DynamicResource StaticTextFgBrush}" LineHeight="20" ToolTip="由 [StaticTextForegroundColor] 靜態文字前景色控制" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button x:Name="BtnWaitPageUp" Content="上一頁" Height="50" Width="100" Margin="0" FontSize="26" Style="{StaticResource FunctionButtonStyle}" />
                                                            <Button x:Name="BtnWaitPageDown" Content="下一頁" Height="50" Width="100" Margin="10,0,0,0" FontSize="26" Style="{StaticResource FunctionButtonStyle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>

                                                <!-- Mini Video Player -->
                                                <Border Grid.Row="1" Background="#000000" BorderThickness="0" Margin="0,4,0,0">
                                                    <Grid>
                                                        <!-- Player Control Overlay Bar -->
                                                        <Border VerticalAlignment="Bottom" Background="#EA080808" Padding="8,4">
                                                            <StackPanel>
                                                                <!-- Progress Slider Row -->
                                                                <Grid Margin="0,0,0,4">
