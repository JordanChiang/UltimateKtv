                            <Button x:Name="BtnNavSongAdded" Content="✉️ 點播成功提示" Style="{StaticResource CategoryNavButton}" Click="BtnNavSongAdded_Click" Margin="0,0,5,5" />
                            <Button x:Name="BtnNavBroadcast" Content="📢 系統廣播" Style="{StaticResource CategoryNavButton}" Click="BtnNavBroadcast_Click" Margin="0,0,5,5" />
                            <Button x:Name="BtnNavMockData" Content="🛠️ 模擬資料" Style="{StaticResource CategoryNavButton}" Click="BtnNavMockData_Click" Margin="0,0,5,5" />
                        </WrapPanel>

                        <!-- Form Scroll Area -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                            <StackPanel Margin="0,0,8,0">

                                <!-- CARD 1: 跑馬燈設定 (播放 & 啟動共用) -->
                                <StackPanel x:Name="CardPlayback">
                                    <Border Background="#232332" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="🎵 跑馬燈外觀與文字設定 (啟動/播放共用)" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Border>

                                    <!-- Font Family -->
                                    <TextBlock Text="文字字型 (FontFamily):" FontWeight="SemiBold" Margin="0,2,0,2" />
                                    <ComboBox x:Name="CboFontFamily" DisplayMemberPath="DisplayName" SelectionChanged="ParamChanged" Margin="0,0,0,6" />

                                    <!-- 2 Colors Side by Side -->
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Fill Color -->
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="文字填滿顏色 (點色塊選色):" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtFillColor" TextChanged="ParamChanged" />
                                                <Border x:Name="RectFillColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectFillColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                            </Grid>
                                        </StackPanel>

                                        <!-- Stroke Color -->
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="文字描邊顏色 (點色塊選色):" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtStrokeColor" TextChanged="ParamChanged" />
                                                <Border x:Name="RectStrokeColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectStrokeColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 6 參數集中 3 行左右併排 -->
                                    <Grid Margin="0,2,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- ROW 1 Left: 字體粗細 -->
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                            <TextBlock Text="字體粗細 (FontWeight):" FontWeight="SemiBold" Margin="0,0,0,2" />
                                            <ComboBox x:Name="CboFontWeight" SelectionChanged="ParamChanged" />
                                        </StackPanel>

                                        <!-- ROW 1 Right: 字體大小 -->
                                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="字體大小:" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="範圍: 12 ~ 128 像素" />
                                                <TextBlock x:Name="LblFontSize" Grid.Column="1" Text="72 像素" FontWeight="Bold" Foreground="#82B1FF" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </Grid>
                                            <Slider x:Name="SldFontSize" Minimum="12" Maximum="128" Value="72" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />
                                        </StackPanel>

                                        <!-- ROW 2 Left: 文字描邊 -->
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="文字描邊:" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="範圍: 0 ~ 32 像素" />
                                                <TextBlock x:Name="LblStrokeThickness" Grid.Column="1" Text="8 像素" FontWeight="Bold" Foreground="#82B1FF" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </Grid>
                                            <Slider x:Name="SldStrokeThickness" Minimum="0" Maximum="32" Value="8" ValueChanged="ParamChanged" />
                                        </StackPanel>

                                        <!-- ROW 2 Right: 滾動速度 -->
                                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="滾動速度:" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="範圍: 100 ~ 1000 像素/秒" />
                                                <TextBlock x:Name="LblSpeed" Grid.Column="1" Text="200 像素/秒" FontWeight="Bold" Foreground="#82B1FF" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </Grid>
                                            <Slider x:Name="SldSpeed" Minimum="100" Maximum="1000" Value="200" TickFrequency="100" IsSnapToTickEnabled="True" SmallChange="100" LargeChange="100" ValueChanged="ParamChanged" />
                                        </StackPanel>

                                        <!-- ROW 3 Left: 間隔時間 -->
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="間隔時間:" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="範圍: 0 ~ 5 秒" />
                                                <TextBlock x:Name="LblHoldTime" Grid.Column="1" Text="1 秒" FontWeight="Bold" Foreground="#82B1FF" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </Grid>
                                            <Slider x:Name="SldHoldTime" Minimum="0" Maximum="5" Value="1" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="1" ValueChanged="ParamChanged" />
                                        </StackPanel>

                                        <!-- ROW 3 Right: 重覆次數 -->
                                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,6">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="重覆次數:" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="範圍: 0 ~ 10 次 (0=關閉)" />
                                                <TextBlock x:Name="LblPlayCount" Grid.Column="1" Text="2 次" FontWeight="Bold" Foreground="#82B1FF" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </Grid>
                                            <Slider x:Name="SldPlayCount" Minimum="0" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="1" ValueChanged="ParamChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <Separator Background="#353545" Margin="0,4,0,6" />

                                    <TextBlock Text="範本 1 (有待播歌曲 - MarqueeTextString1):" FontWeight="SemiBold" Margin="0,2,0,2" />
                                    <TextBox x:Name="TxtTemplate1" TextWrapping="Wrap" Height="42" Padding="6,0" TextAlignment="Left" VerticalContentAlignment="Center" TextChanged="ParamChanged" GotFocus="TxtTemplate_GotFocus" />

                                    <TextBlock Text="範本 2 (無待播歌曲 - MarqueeTextString2):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <TextBox x:Name="TxtTemplate2" TextWrapping="Wrap" Height="42" Padding="6,0" TextAlignment="Left" VerticalContentAlignment="Center" TextChanged="ParamChanged" GotFocus="TxtTemplate_GotFocus" />

                                    <TextBlock Text="範本 3 (隨機播放無待播 - MarqueeTextString3):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <TextBox x:Name="TxtTemplate3" TextWrapping="Wrap" Height="42" Padding="6,0" TextAlignment="Left" VerticalContentAlignment="Center" TextChanged="ParamChanged" GotFocus="TxtTemplate_GotFocus" />

                                    <TextBlock Text="啟動跑馬燈範本 (進入程式時 - MarqueeTextStartup):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <TextBox x:Name="TxtTemplateStartup" TextWrapping="Wrap" Height="42" Padding="6,0" TextAlignment="Left" VerticalContentAlignment="Center" TextChanged="ParamChanged" GotFocus="TxtTemplate_GotFocus" />

                                    <TextBlock Text="參數: {0}=歌名, {1}=歌手, {2}=下首歌名, {3}=下首歌手, {4}=區網網址, {5}=外網網址, {6}=本首點播者, {7}=下首點播者" Foreground="#FFD54F" FontSize="13.5" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- CARD 2: 點播成功提示 -->
                                <StackPanel x:Name="CardSongAdded" Visibility="Collapsed">
                                    <Border Background="#232332" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                                        <TextBlock Text="✉️ 點播成功提示設定" FontWeight="Bold" FontSize="15" Foreground="#82B1FF" />
                                    </Border>
                                    <TextBlock Text="點播成功文字範本 (MarqueeSongAddedString):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <TextBox x:Name="TxtSongAddedTemplate" TextWrapping="Wrap" Height="42" Padding="6,0" TextAlignment="Left" VerticalContentAlignment="Center" TextChanged="ParamChanged" />
                                    <TextBlock Text="參數: {0}=歌名, {1}=歌手, {4}=區網網址, {5}=外網網址, {6}=本首點播者" Foreground="#FFD54F" FontSize="13.5" FontWeight="SemiBold" Margin="0,4,0,8" TextWrapping="Wrap" />

                                    <TextBlock Text="點播成功字型 (FontFamily):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <ComboBox x:Name="CboSongAddedFontFamily" DisplayMemberPath="DisplayName" SelectionChanged="ParamChanged" />

                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="字體大小 (12 ~ 128 像素):" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LblSongAddedFontSize" Grid.Column="1" Text="48 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Grid>
                                    <Slider x:Name="SldSongAddedFontSize" Minimum="12" Maximum="128" Value="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                    <TextBlock Text="文字顏色 (點擊色塊開啟調色盤):" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtSongAddedFillColor" TextChanged="ParamChanged" />
                                        <Border x:Name="RectSongAddedFillColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectSongAddedFillColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                    </Grid>

                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="顯示時間 (0 ~ 60 秒, 0=關閉):" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LblSongAddedDuration" Grid.Column="1" Text="3 秒" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Grid>
                                    <Slider x:Name="SldSongAddedDuration" Minimum="0" Maximum="60" Value="3" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />
                                </StackPanel>

                                <!-- CARD 4: 系統廣播 -->
                                <StackPanel x:Name="CardBroadcast" Visibility="Collapsed">
                                    <Border Background="#232332" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="📢 系統廣播設定 (音量/音調等)" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Border>
                                    <TextBlock Text="系統廣播字型 (FontFamily):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <ComboBox x:Name="CboBroadcastFontFamily" DisplayMemberPath="DisplayName" SelectionChanged="ParamChanged" />

                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="廣播字體大小 (12 ~ 128 像素):" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LblBroadcastFontSize" Grid.Column="1" Text="48 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Grid>
                                    <Slider x:Name="SldBroadcastFontSize" Minimum="12" Maximum="128" Value="48" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                    <TextBlock Text="廣播文字顏色 (點擊色塊開啟調色盤):" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtBroadcastFillColor" TextChanged="ParamChanged" />
                                        <Border x:Name="RectBroadcastFillColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectBroadcastFillColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                    </Grid>

                                    <Grid Margin="0,6,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="廣播顯示時間 (0 ~ 60 秒, 0=關閉):" FontWeight="SemiBold" />
                                        <TextBlock x:Name="LblBroadcastDuration" Grid.Column="1" Text="3 秒" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Grid>
                                    <Slider x:Name="SldBroadcastDuration" Minimum="0" Maximum="60" Value="3" ValueChanged="ParamChanged" />
                                </StackPanel>

                                <!-- CARD 5: 模擬資料 -->
                                <StackPanel x:Name="CardMockData" Visibility="Collapsed">
                                    <Border Background="#232332" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                                        <TextBlock Text="🛠️ 模擬測試資料" FontWeight="Bold" Foreground="#82B1FF" />
                                    </Border>
                                    <TextBlock Text="當前歌名 {0}:" FontWeight="SemiBold" Margin="0,4,0,2" />
                                    <TextBox x:Name="TxtMockSong" Text="晴天" TextChanged="ParamChanged" />

                                    <TextBlock Text="當前歌手 {1}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockSinger" Text="周杰倫" TextChanged="ParamChanged" />

                                    <TextBlock Text="下首歌名 {2}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockNextSong" Text="再見" TextChanged="ParamChanged" />

                                    <TextBlock Text="下首歌手 {3}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockNextSinger" Text="鄧紫棋" TextChanged="ParamChanged" />

                                    <TextBlock Text="區網 IP:Port {4}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockLanIp" Text="192.168.1.100:8080" TextChanged="ParamChanged" />

                                    <TextBlock Text="外網 IP:Port {5}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockWanIp" Text="220.222.1.1:8080" TextChanged="ParamChanged" />

                                    <TextBlock Text="本首點播者 {6}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockOrderedBy" Text="小強" TextChanged="ParamChanged" />

                                    <TextBlock Text="下首點播者 {7}:" FontWeight="SemiBold" Margin="0,6,0,2" />
                                    <TextBox x:Name="TxtMockNextOrderedBy" Text="小明" TextChanged="ParamChanged" />
                                </StackPanel>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- PANEL 2: textsettings.json UI 專屬設定面板 -->
                    <Grid x:Name="TextSettingsGrid" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header with Reset Button -->
                        <Border Grid.Row="0" Background="#242432" CornerRadius="4" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="🎨 textsettings.json 點歌機介面字級與配色" FontWeight="Bold" Foreground="#82B1FF" />
                                <Button Content="🔄 回復預設值" HorizontalAlignment="Right" Style="{StaticResource ResetButton}" Click="BtnResetTextSettingsDefaults_Click" ToolTip="將點歌機介面所有字體與色彩重設為原廠預設值" />
                            </Grid>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <StackPanel Margin="0,0,8,0">

                                <!-- TOP OPTION: 歌曲清單列外觀風格 (Song List Row Style) -->
                                <Border Background="#1A2035" BorderBrush="#3D5AFE" BorderThickness="1.5" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="📋 歌曲列表外觀風格 (Song List Row Style)" FontWeight="Bold" Foreground="#82B1FF" Margin="0,0,0,6" />
                                        <ComboBox x:Name="CboSongListRowStyle" Margin="0,0,0,4" SelectionChanged="CboSongListRowStyle_SelectionChanged"
                                                  Height="34" FontSize="13.5">
                                            <ComboBoxItem Content="✨ 風格 1：現代懸浮微圓角卡片 (推薦)" Tag="1" IsSelected="True" />
                                            <ComboBoxItem Content="💊 風格 2：膠囊外框輪廓風格" Tag="2" />
                                            <ComboBoxItem Content="🔖 風格 3：左側主色指示條卡片" Tag="3" />
                                            <ComboBoxItem Content="🌟 風格 4：靜態微光光暈風格" Tag="4" />
                                        </ComboBox>
                                        <TextBlock Text="💡 選擇後即時套用至左側模擬畫面，儲存後直接生效於主程式。" Foreground="#9FA8DA" FontSize="11" Margin="2,2,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- THEME PRESETS SELECTOR -->
                                <Border Background="#1C2438" BorderBrush="#3D5AFE" BorderThickness="1.5" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="🎭 範本主題快速套用 (Sample Presets)" FontWeight="Bold" Foreground="#82B1FF" VerticalAlignment="Center" />
                                            <TextBlock Text="參照 SampleSettings" FontSize="11" Foreground="#90CAF9" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <ComboBox x:Name="CboThemePresets" SelectionChanged="CboThemePresets_SelectionChanged">
                                            <ComboBoxItem Content="-- 自訂或目前配置 (Custom) --" Tag="" IsSelected="True" />
                                            <ComboBoxItem Content="⚡ 電光藍 (Electric Blue) [截圖範例]" Tag="textsettings_electric_blue.json" />
                                            <ComboBoxItem Content="🌲 森林綠 (Forest Green)" Tag="textsettings_forest_green.json" />
                                            <ComboBoxItem Content="💖 熱力粉 (Hot Pink)" Tag="textsettings_hot_pink.json" />
                                            <ComboBoxItem Content="🌊 海洋青 (Ocean Cyan)" Tag="textsettings_ocean_cyan.json" />
                                            <ComboBoxItem Content="🌅 日落橘 (Sunset Orange)" Tag="textsettings_sunset_orange.json" />
                                            <ComboBoxItem Content="🔮 炫麗紫 (Vivid Purple)" Tag="textsettings_vivid_purple.json" />
                                            <ComboBoxItem Content="🌟 原廠預設金琥珀 (Default Amber)" Tag="textsettings_default_amber.json" />
                                        </ComboBox>
                                        <TextBlock Text="💡 選擇主題將即時更新下方各項參數並在右側 1:1 模擬畫面精確展現" FontSize="11" Foreground="#9E9E9E" Margin="2,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 1: 字型與字級 -->
                                <Border Background="#232332" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                    <TextBlock Text="🔤 點歌機全域字型與字級" FontWeight="Bold" Foreground="#82B1FF" />
                                </Border>

                                <TextBlock Text="點歌機全域字型 (FontFamily):" FontWeight="SemiBold" Margin="0,2,0,2" />
                                <ComboBox x:Name="CboUiFontFamily" DisplayMemberPath="DisplayName" SelectionChanged="ParamChanged" Margin="0,0,0,6" />

                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="歌曲清單字體大小 (SongListFontSize):" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LblSongListFontSize" Grid.Column="1" Text="38 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                </Grid>
                                <Slider x:Name="SldSongListFontSize" Minimum="16" Maximum="72" Value="38" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="待播清單字體大小 (WaitingListFontSize):" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LblWaitingListFontSize" Grid.Column="1" Text="24 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                </Grid>
                                <Slider x:Name="SldWaitingListFontSize" Minimum="12" Maximum="60" Value="24" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="功能按鈕字體大小 (FuncBtnFontSize):" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LblFuncBtnFontSize" Grid.Column="1" Text="32 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                </Grid>
                                <Slider x:Name="SldFuncBtnFontSize" Minimum="14" Maximum="64" Value="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="底部按鈕字體大小 (BottomButtonFontSize):" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LblBottomButtonFontSize" Grid.Column="1" Text="36 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                </Grid>
                                <Slider x:Name="SldBottomButtonFontSize" Minimum="14" Maximum="64" Value="36" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                <Grid Margin="0,4,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="網路主機資訊字體大小 (WebHostInfoFontSize):" FontWeight="SemiBold" />
                                    <TextBlock x:Name="LblWebHostInfoFontSize" Grid.Column="1" Text="32 像素" FontWeight="Bold" Foreground="#82B1FF" />
                                </Grid>
                                <Slider x:Name="SldWebHostInfoFontSize" Minimum="12" Maximum="60" Value="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ParamChanged" />

                                <Separator Background="#353545" Margin="0,10" />

                                <!-- SECTION 2: 文字前景色 -->
                                <Border Background="#232332" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                    <TextBlock Text="💬 文字前景色 (Text Colors)" FontWeight="Bold" Foreground="#82B1FF" />
                                </Border>

                                <!-- Announcement Foreground -->
                                <TextBlock Text="系統公告前景色 (AnnouncementForegroundColor):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAnnouncementFg" Text="#FFFFFF" TextChanged="ParamChanged" />
                                    <Border x:Name="RectAnnouncementFg" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectAnnouncementFg_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>

                                <!-- Static Text Foreground -->
                                <TextBlock Text="靜態文字前景色 (StaticTextForegroundColor):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtStaticTextFg" Text="#FFFFFF" TextChanged="ParamChanged" />
                                    <Border x:Name="RectStaticTextFg" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectStaticTextFg_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>

                                <!-- Web Host Info Foreground -->
                                <TextBlock Text="網路主機資訊前景色 (WebHostInfoForegroundColor):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtWebHostInfoFg" Text="#FFFFFF" TextChanged="ParamChanged" />
                                    <Border x:Name="RectWebHostInfoFg" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectWebHostInfoFg_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>


                                <Separator Background="#353545" Margin="0,10" />

                                <!-- SECTION 3: UI 佈景與主題色彩 -->
                                <Border Background="#232332" CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                    <TextBlock Text="🎨 UI 佈景與主題筆刷 (Theme &amp; UI Brushes)" FontWeight="Bold" Foreground="#82B1FF" />
                                </Border>

                                <!-- Primary Color -->
                                <TextBlock Text="主要主題色 (PrimaryColor - 視窗外框/按鈕/清單外框/滑桿):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPrimaryColor" Text="#FFB300" TextChanged="TxtPrimaryColor_TextChanged" />
                                    <Border x:Name="RectPrimaryColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectPrimaryColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>

                                <!-- Harmonize Tools Box -->
                                <Border Background="#1C2235" BorderBrush="#3949AB" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                                    <StackPanel>
                                        <CheckBox x:Name="ChkAutoHarmonize" Content="變更主色時自動調配全套衍生色彩" IsChecked="True" Foreground="#90CAF9" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="開啟時，變更 PrimaryColor 會自動依色彩學調配深色、淺色標籤與標題列底色" />
                                        <Button x:Name="BtnHarmonize" Content="⚡ 依主要色彩自動調配全套配色" Click="BtnHarmonize_Click" Background="#303F9F" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12.5" Padding="8,4" Margin="0,6,0,0" Height="28" Cursor="Hand" ToolTip="依據目前 PrimaryColor 重新調配下方所有主題關聯色階" />
                                    </StackPanel>
                                </Border>

                                <!-- Primary Light Color -->
                                <TextBlock Text="主要淺色顏色 (PrimaryLightColor - 歌曲懸停/歌手高亮標籤背景):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtPrimaryLightColor" Text="#FFECB3" TextChanged="ParamChanged" />
                                    <Border x:Name="RectPrimaryLightColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectPrimaryLightColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>
                                
                                <!-- Accent / Glow Color -->
                                <TextBlock Text="按鈕發光與選中強調色 (AccentColor - Cyber 按鈕發光與選中高亮):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtAccentColor" Text="" TextChanged="ParamChanged" ToolTip="留空時自動依 PrimaryColor 計算" />
                                    <Border x:Name="RectAccentColor" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectAccentColor_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>
                                <CheckBox x:Name="ChkAutoAccentColor" Content="自動根據主色調生成發光色 (Auto Derive)" IsChecked="True" Foreground="#80D8FF" FontWeight="Normal" Margin="0,0,0,6" Click="ChkAutoAccentColor_Click" ToolTip="打勾時發光與選中色彩自動跟隨 PrimaryColor；取消打勾可自由指定顏色" />
                                
                                <!-- DataGrid Column Header Foreground -->
                                <TextBlock Text="表格標題文字顏色 (DataGridColumnHeaderForegroundColor):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDataGridHeaderFg" Text="#FFFFFFFF" TextChanged="ParamChanged" />
                                    <Border x:Name="RectDataGridHeaderFg" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectDataGridHeaderFg_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>

                                <!-- DataGrid Header Bg -->
                                <TextBlock Text="表格標題背景顏色 (DataGridColumnHeaderBackgroundColor):" FontWeight="SemiBold" Margin="0,4,0,2" />
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDataGridHeaderBg" Text="#FF4A4A4A" TextChanged="ParamChanged" />
                                    <Border x:Name="RectDataGridHeaderBg" Grid.Column="1" Margin="6,0,0,0" CornerRadius="4" BorderBrush="#777" BorderThickness="1.5" Cursor="Hand" MouseDown="RectDataGridHeaderBg_MouseDown" ToolTip="點擊開啟調色盤選色" />
                                </Grid>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" Background="#0C0C11" BorderBrush="#1C1C24" BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock Text="💡 提示: 點擊上方跑馬燈按鈕會自動切換右側參數分頁；點擊色彩方塊可直接叫出調色盤選色。" Foreground="#9FA8DA" FontSize="13" />
        </StatusBar>
    </Grid>
</Window>
