<Window x:Class="StyleSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StyleSimulator"
        Title="UltimateKTV 樣式與效果模擬器"
        MinWidth="1024" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontSize="14"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="#141419" Foreground="#EAEAEA">
    <Window.Resources>
        <!-- Dynamic Theme Brushes for Live KTV Preview -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FFB300" />
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="#FFE082" />
        <LinearGradientBrush x:Key="DataGridHeaderBgBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFA000" Offset="0.0"/>
            <GradientStop Color="#FFCA28" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrushCyberActiveGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E6FFB300" Offset="0.0"/>
            <GradientStop Color="#D08A6403" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrushCyberButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#42FFB300" Offset="0.0"/>
            <GradientStop Color="#14664D00" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DataGridHeaderFgBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="AnnouncementFgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="StaticTextFgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="WebHostInfoFgBrush" Color="#FFFFFF" />

        <!-- Option 4 Inward Glow Dynamic Brushes (朝內微光，未選取純淨無橫紋) -->
        <SolidColorBrush x:Key="BrushInnerGlowDefault" Color="#181B24"/>
        <LinearGradientBrush x:Key="BrushInnerGlowHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#60FFE082" Offset="0.0"/>
            <GradientStop Color="#18FFE082" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrushInnerGlowActive" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#A0FFB300" Offset="0.0"/>
            <GradientStop Color="#30FFB300" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrushInnerGlowActiveHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#C0FFE082" Offset="0.0"/>
            <GradientStop Color="#40FFE082" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- 風格 3 (AccentStrip) 預設漸層筆刷 -->
        <LinearGradientBrush x:Key="BrushAccentStripActive" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F59E0B" Offset="0.0"/>
            <GradientStop Color="#FFF9C4" Offset="0.4"/>
            <GradientStop Color="#FFCA28" Offset="0.6"/>
            <GradientStop Color="#D97706" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrushAccentStripHover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFE082" Offset="0.0"/>
            <GradientStop Color="#FFFFFF" Offset="0.45"/>
            <GradientStop Color="#FFD54F" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrushAccentStripInactive" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#546E7A" Offset="0.0"/>
            <GradientStop Color="#CFD8DC" Offset="0.45"/>
            <GradientStop Color="#90A4AE" Offset="0.6"/>
            <GradientStop Color="#37474F" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrushAccentStripGlow" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#50FFA000" Offset="0.0"/>
            <GradientStop Color="#18FFA000" Offset="0.5"/>
            <GradientStop Color="#00FFA000" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- 選中文字立體金屬漸層筆刷 -->
        <LinearGradientBrush x:Key="BrushTextSelectedGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFFF0" Offset="0.0"/>
            <GradientStop Color="#FFFDE7" Offset="0.25"/>
            <GradientStop Color="#FFE082" Offset="0.55"/>
            <GradientStop Color="#FFB300" Offset="0.85"/>
            <GradientStop Color="#FF8F00" Offset="1.0"/>
        </LinearGradientBrush>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAEAEA" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#22222D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#44445A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontSize" Value="14.5" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#22222D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#38384D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3F51B5" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle Button for ComboBox -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="26" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="#CCCCCC"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2D2D3B" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#5C5C7A" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#FFFFFF" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#2D2D3B" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#82B1FF" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#22222D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#44445A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}"
                                          Grid.Column="2" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" />
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="9,5,28,5"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextBlock.Foreground="{TemplateBinding Foreground}" />
                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Margin="6,3,26,3" Focusable="True" Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}"
                                     Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <Popup Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1C1C24"
                                            BorderThickness="1" BorderBrush="#44445A" CornerRadius="4" Margin="0,2,0,0">
                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button" x:Key="ActionButton">
            <Setter Property="Background" Value="#3F51B5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5C6BC0" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Style for the top function buttons (Matches MainWindow.xaml) -->
        <Style x:Key="FunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="Height" Value="50" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Margin" Value="4,0,4,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- Style for player control buttons (Matches MainWindow.xaml) -->
        <Style x:Key="PlayerControlButtonStyle" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="Height" Value="50" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for submenu player control buttons (人聲, 重播 - Matches MainWindow.xaml) -->
        <Style x:Key="SubmenuPlayerControlButtonStyle" TargetType="Button" BasedOn="{StaticResource CyberSubmenuButton}">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="Height" Value="50" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Grid Background="Transparent">
                            <TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                            <Path Data="M 0,8 L 8,0 L 8,8 Z" 
                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" 
                                  Opacity="0.85" 
                                  HorizontalAlignment="Right" 
                                  VerticalAlignment="Bottom" 
                                  Margin="0,0,6,6" 
                                  IsHitTestVisible="False" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for large player control button (切歌 - Matches MainWindow.xaml) -->
        <Style x:Key="LargePlayerControlButtonStyle" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Height" Value="110" />
            <Setter Property="Width" Value="122" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource SingerButtonBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource SingerButtonBackground}" />
        </Style>

        <!-- Style for pagination buttons (上一頁 / 下一頁 - Matches MainWindow.xaml) -->
        <Style x:Key="PaginationButtonStyle" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="FontSize" Value="36" />
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="50" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- Style for category filter buttons (Matches MainWindow.xaml) -->
        <Style x:Key="SecondFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource CyberButton}">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style TargetType="Button" x:Key="KtvOutlinedButton" BasedOn="{StaticResource CyberButton}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <!-- Modern KTV Player Slider Style with Dynamic Theme Color Binding -->
        <Style x:Key="KtvSliderStyle" TargetType="Slider">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="{DynamicResource PrimaryBrush}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Width="14" Height="14" Fill="{DynamicResource PrimaryBrush}" Stroke="#FFFFFF" StrokeThickness="1.5" Cursor="Hand" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="6" CornerRadius="3" Background="#333344" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="SuccessButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#2E7D32" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#388E3C" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#C62828" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#37474F" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#455A64" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="ResetButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#E65100" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="FontSize" Value="13.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF6C00" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button" x:Key="CategoryNavButton" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#232332" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3A3A4C" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E2E42" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header & File Toolbar -->
            <RowDefinition Height="*" />    <!-- Main Split Area -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="#0F0F14" BorderBrush="#22222E" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Title -->
                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="🎤" FontSize="24" Margin="0,0,8,0" />
                    <StackPanel>
                        <TextBlock Text="UltimateKTV 樣式與效果模擬器" FontSize="18" FontWeight="Bold" Foreground="#82B1FF" />                        
                    </StackPanel>
                </StackPanel>

                <!-- File Selector & Actions (Responsive WrapPanel) -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,6,2">
                        <TextBlock Text="目前編輯檔:" Foreground="#CCC" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <ComboBox x:Name="CboConfigFileType" Width="160" SelectionChanged="CboConfigFileType_SelectionChanged">
                            <ComboBoxItem Content="🎨 UI介面" IsSelected="True" />
                            <ComboBoxItem Content="⚙️ 跑馬燈/提示" />
                        </ComboBox>
                    </StackPanel>
                    <TextBox x:Name="TxtActiveFilePath" MinWidth="130" MaxWidth="280" IsReadOnly="True" Margin="0,2,6,2" VerticalAlignment="Center" ToolTip="目前載入的設定檔路徑" />
                    <Button Content="📁 瀏覽..." Style="{StaticResource SecondaryButton}" Click="BtnBrowse_Click" Margin="0,2,6,2" />
                    <Button Content="🔄 重新載入" Style="{StaticResource SecondaryButton}" Click="BtnReload_Click" Margin="0,2,6,2" />
                    <Button Content="💾 儲存目前檔" Style="{StaticResource SuccessButton}" Click="BtnSaveCurrent_Click" Margin="0,2,6,2" />
                    <Button Content="💾 儲存全部 (雙檔)" Style="{StaticResource ActionButton}" Click="BtnSaveAll_Click" Margin="0,2,0,2" />
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Content="⏹️ 停止動畫" Style="{StaticResource DangerButton}" Click="BtnStop_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Margin="10,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="460" /> <!-- Left: Live Preview -->
                <ColumnDefinition Width="Auto" />              <!-- Draggable Splitter -->
                <ColumnDefinition Width="2*" MinWidth="380" /> <!-- Right: Dedicated Settings -->
            </Grid.ColumnDefinitions>

            <!-- Left: Dynamic View (Switches automatically based on selected file) -->
            <Grid Grid.Column="0" Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- Test Buttons Toolbar -->
                    <RowDefinition Height="*" />    <!-- Screen Canvas -->
                    <RowDefinition Height="Auto" /> <!-- Status Info -->
                </Grid.RowDefinitions>

                <!-- Top Quick Test Bar (Visible when settings.json is active) -->
                <Border x:Name="MarqueeTestBar" Grid.Row="0" Background="#1D1D27" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="⚡ 點擊跑馬燈進行模擬並檢視右側完整參數:" FontWeight="Bold" Margin="0,0,0,6" Foreground="#FFD54F" />
                        <WrapPanel>
                            <Button Content="🎵 播放跑馬燈 (1:有待播)" Style="{StaticResource ActionButton}" Click="BtnPlaySong1_Click" Margin="0,0,5,5" ToolTip="點擊模擬播放並在右側列出範本1完整參數" />
                            <Button Content="🎵 播放跑馬燈 (2:無待播)" Style="{StaticResource ActionButton}" Click="BtnPlaySong2_Click" Margin="0,0,5,5" ToolTip="點擊模擬播放並在右側列出範本2完整參數" />
                            <Button Content="🎲 隨機播放 (3)" Style="{StaticResource ActionButton}" Click="BtnPlaySong3_Click" Margin="0,0,5,5" ToolTip="點擊模擬播放並在右側列出範本3完整參數" />
                            <Button Content="🚀 啟動跑馬燈 (Startup)" Style="{StaticResource ActionButton}" Click="BtnPlayStartup_Click" Margin="0,0,5,5" ToolTip="點擊模擬播放並在右側列出啟動跑馬燈完整參數" />
                            <Button Content="✉️ 點播成功提示" Style="{StaticResource SuccessButton}" Click="BtnSongAdded_Click" Margin="0,0,5,5" ToolTip="點擊模擬顯示並在右側列出點播成功完整參數" />
                            <Button Content="🔊 系統廣播 (音量)" Style="{StaticResource ActionButton}" Click="BtnBroadcast_Click" Margin="0,0,5,5" ToolTip="點擊模擬顯示並在右側列出系統廣播完整參數" />
                            <Button Content="⚡ 佇列測試 (點歌+播放)" Style="{StaticResource SecondaryButton}" Click="BtnQueueTest_Click" Margin="0,0,5,5" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- UI Info Bar (Visible when textsettings.json is active) -->
                <Border x:Name="UiInfoBar" Grid.Row="0" Background="#1D1D27" CornerRadius="6" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎨 點歌機操作介面 (UI 樣式與排版模擬)" FontWeight="Bold" Foreground="#82B1FF" VerticalAlignment="Center" />
                        <TextBlock Text="（調整右側字級與顏色立即反映於下方介面）" Foreground="#AAA" Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" />
