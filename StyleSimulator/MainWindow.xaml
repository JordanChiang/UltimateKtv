                                                                    <TextBlock x:Name="IconLock" Grid.Column="2" Text="🔒" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" ToolTip="由 [PrimaryColor] 主要主題色控制" />
                                                                    <TextBlock x:Name="IconMenu" Grid.Column="3" Text="☰" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" ToolTip="由 [PrimaryColor] 主要主題色控制" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DockPanel>

                                        <!-- ==================== RIGHT PANEL ==================== -->
                                        <Grid Grid.Column="2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /> <!-- Top 5 Filter Buttons -->
                                                <RowDefinition Height="*" />    <!-- 13-row Song List DataGrid -->
                                                <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
                                            </Grid.RowDefinitions>

                                            <!-- Top 5 Category Filter Buttons (Matches screenshot) -->
                                            <UniformGrid Grid.Row="0" Rows="1" Columns="5" Margin="0,0,0,8">
                                                <Button x:Name="FilterBtn1" Content="國語-單曲" Style="{StaticResource SecondFilterButtonStyle}" />
                                                <Button x:Name="FilterBtn2" Content="台語-單曲" Style="{StaticResource SecondFilterButtonStyle}" />
