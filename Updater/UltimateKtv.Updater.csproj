<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net471</TargetFramework>
    <Platforms>x86</Platforms>
    <AssemblyName>UltimateKtv.Updater</AssemblyName>
    <ApplicationIcon>UpdaterIcon.ico</ApplicationIcon>
    <!-- 相依只剩 GAC framework 組件，無版本衝突，不需 binding redirect；
         留著會在 publish 產生/複製 .exe.config (相依砍光後該檔不生成，反而導致 MSB3030)。 -->
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <LangVersion>latest</LangVersion>
    <!-- 不論用 VS (帶 Platform=x86) 或 dotnet CLI 發佈都不產生 pdb，維持單一 exe -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- 確定性建置會把 PE 標頭時間戳記填成雜湊值 (例如 2052 年)。「未來的編譯時間」是防毒 ML 的可疑特徵：
         實測 CrowdStrike 因此以 60% 判為惡意、Hybrid Analysis 75 分；改用真實時間戳記後為 no specific threat。 -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <!-- Delete the .config file after build to maintain a single-file distribution -->
  <Target Name="DeleteConfig" AfterTargets="CopyFilesToOutputDirectory">
    <Delete Files="$(TargetDir)$(TargetFileName).config" />
  </Target>

  <!-- publish 會從 obj 另外複製一份 .exe.config 到 PublishDir，上面的 build 刪除管不到，publish 後也要刪 -->
  <Target Name="DeletePublishedConfig" AfterTargets="Publish">
    <Delete Files="$(PublishDir)$(TargetFileName).config" />
  </Target>

  <!-- 皆為 .NET Framework GAC 內建組件 (CopyLocal=false)，不會多出可散佈 DLL；
       System.Web.Extensions 提供 JavaScriptSerializer，取代 System.Text.Json，讓 Updater 維持單一 exe。 -->
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Update\ZipHelper.cs" Link="ZipHelper.cs" />
  </ItemGroup>
</Project>
