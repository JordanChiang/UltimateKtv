  "SettingDesc.HttpServerPort": "Հեռակա սերվերի պորտ՝ HTTP սերվերի պորտ։",

  "SettingDesc.LimitCursorOnMain": "Կուրսորը գլխավոր էկրանին ամրացնելը. միացված լինելու դեպքում Windows մկնիկի կուրսորը պահվում է կոնսոլի էկրանում (էկրան 1)։",
  "SettingDesc.PlayHistoryCount": "Նվագարկման պատմությունը պահպանվում է՝ տվյալների բազայում պահվող նվագարկման պատմության գրառումների քանակը (1-10)։ Լռելյայն արժեքը՝ 5։",
  "SettingDesc.SongSortMethod": "Երգերի տեսակավորման կարգը՝ 1=նվագարկումների քանակը, 2=ավելացման ամսաթիվը, 3=վերնագրի տևողությունը։ Լռելյայն արժեքը՝ 1։",
  "SettingDesc.IsAppLoggerEnabled": "Ծրագրերի գրանցամատյան՝ միացնել կամ անջատել ծրագրերի գրանցամատյանը։ true=միացված, false=անջատված։",
