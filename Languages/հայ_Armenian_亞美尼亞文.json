  "SettingDesc.RandomPlayEnabled": "Պատահական նվագարկում՝ միացնել պատահական նվագարկման ռեժիմը: true=միացված, false=անջատված:",
  "SettingDesc.RandomPlayCategory": "Պատահական նվագարկման կատեգորիա՝ 0=Մանդարինյան չարթեր, 1=Թայվանական չարթեր, 2=նոր երգեր, 3=բոլոր չարթերը, 10=իմ սիրելիները: Լռելյայն՝ 0։",
  "SettingDesc.RandomPlayFavoriteUser": "Պատահական նվագարկման նախընտրելի օգտատեր. օգտատիրոջ անուն «Իմ նախընտրելիները» պատահական նվագարկման ռեժիմի համար։",
  "SettingDesc.RandomPlayAudioChannel": "Պատահական նվագարկման ալիք. աուդիո ալիք պատահական նվագարկման համար։ 0=վոկալ, 1=բեք թրեք։ Լռելյայն՝ 0։",

  "SettingDesc.IsLegacyAudioChannelDefinitionEnabled": "Ժառանգական ալիքի քարտեզագրում. օգտագործեք ժառանգական աուդիո ալիքի սահմանումը։ Լռելյայն՝ true։ true=միացված, false=անջատված։",
  "SettingDesc.WebDefaultNumOrder": "Վեբը բացում է թվային որոնում. հեռակա վեբ էջը բացվում է «Համարով» ռեժիմում։ true=միացված, false=անջատված։",
  "SettingDesc.VisualSingerStyle": "Վիզուալ երգչի ոճ. ցուցադրել լուսանկարներ երգչի ընտրության մեջ։ true=միացված, false=անջատված։",
  "SettingDesc.SingerPhotoPath": "Երգչի լուսանկարի ուղի. թղթապանակ, որը պահում է երգչի լուսանկարները։",
  "SettingDesc.VisualSingerNameFontSize": "Վիզուալ երգչի անվան չափ. երգիչների անունների տառատեսակի չափը վիզուալ երգչի ոճով։",

  "SettingDesc.HighQualityYoutube": "Youtube HD ներբեռնում. նախընտրելի է բարձր որակ (1080p/720p) YouTube ներբեռնումներ։ true=միացված, false=անջատված։",
  "SettingDesc.YoutubeDefaultNoVocal": "Youtube լռելյայն բեք թրեք. սկսել YouTube տեսանյութերը վոկալը հանած։ true=միացված, false=անջատված։",
  "SettingDesc.YoutubeSearchCount": "Youtube որոնման քանակ. YouTube որոնման արդյունքում վերադարձված տեսանյութերի քանակը։ Վավեր միջակայք՝ 10 - 100: Լռելյայն արժեքը՝ 50:",
  "SettingDesc.YoutubeDownloadDir": "YouTube ներբեռնումների թղթապանակ՝ YouTube ներբեռնումների լռելյայն թղթապանակ:",

  "SettingDesc.GitHubRepoUrl": "GitHub թարմացման աղբյուր՝ GitHub պահոցը ստուգվել է թարմացումների համար (ձևաչափ՝ Սեփականատեր/Պահոց): Լռելյայն արժեքը՝ JordanChiang/UltimateKtv:",
  "SettingDesc.IsLanguageMultiSelect": "Լեզուների բազմակի ընտրություն՝ թույլ է տալիս միաժամանակ մի քանի լեզու ընտրել «Ըստ լեզվի» ​​բաժնում: true=on, false=off:",
  "SettingDesc.UiLanguage": "UI լեզու՝ լեզվի ֆայլի անունը «Լեզուներ» թղթապանակում (օրինակ՝ zh-TW, zh-CN, en):",

  "SettingDesc.EnableRecording": "Միացնել ձայնագրումը. միացնում կամ անջատում է ձայնագրման գործառույթը. true = միացված, false = անջատված։",
  "SettingDesc.RecordingDevice": "Ձայնագրման մուտք. ձայնագրման համար օգտագործվող աուդիո մուտքային սարք։",
  "SettingDesc.RecordingPath": "Ձայնագրման պանակ. տեղ, որտեղ պահվում են ձայնագրությունները։",

  "SettingDesc.MarqueeTextString1": "Շարժվող տեքստի (marquee) ձևանմուշ (պատվիրված երգ, հերթը դատարկ չէ)։ {0} = ընթացիկ երգի անվանում, {1} = ընթացիկ կատարող, {2} = հաջորդ երգի անվանում, {3} = հաջորդ կատարող, {4} = LAN IP:Port, {5} = WAN IP:Port, {6} = պատվիրող, {7} = հաջորդ երգը պատվիրող։ Թողեք լռելյայն արժեքը՝ ինտերֆեյսի լեզվին համապատասխանելու համար։",
  "SettingDesc.MarqueeTextString2": "Շարժվող տեքստի (marquee) ձևանմուշ (պատվիրված երգ, հերթը դատարկ է)։ {0} = ընթացիկ երգի անվանում, {1} = ընթացիկ կատարող, {4} = LAN IP:Port, {5} = WAN IP:Port, {6} = պատվիրող։ Թողեք լռելյայն արժեքը՝ ինտերֆեյսի լեզվին համապատասխանելու համար։",
