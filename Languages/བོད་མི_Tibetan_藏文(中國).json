  "SettingDesc.MarqueeTextString2": "མར་ཁི་ཊེམ་པེལེཊ་(རེ་ཞུ་བྱས་པའི་གླུ་དབྱངས་དང་བང་རིམ་སྟོང་པ་) {0}=ད་ལྟའི་མིང་།, {1}=ད་ལྟའི་གཞས་པ།, {4}=LAN IP:མཐུད་ཁ།, {5}=WAN IP:མཐུད་ཁ།, {6}=རེ་ཞུ་བྱས་པ། UI སྐད་ཡིག་ལ་རྗེས་འཇུག་བྱེད་པར་སྔོན་སྒྲིག་བཞག་རོགས།",
  "SettingDesc.MarqueeTextString3": "མར་ཁི་ཊེམ་པེལེཊ་(གང་བྱུང་རྩེད་མོ་དང་། བང་རིམ་སྟོང་པ་)། {0}=ད་ལྟའི་མིང་།, {1}=ད་ལྟའི་གཞས་པ།, {4}=LAN IP:མཐུད་ཁ།, {5}=WAN IP:མཐུད་ཁ།, {6}=རེ་ཞུ་བྱས་པ། UI སྐད་ཡིག་ལ་རྗེས་འཇུག་བྱེད་པར་སྔོན་སྒྲིག་བཞག་རོགས།",
  "SettingDesc.MarqueeTextStartup": "མར་ཀི་ཊེམ་པེལེཊ་(འགོ་འཛུགས་བརྡ་འཕྲིན)དེ་འགོ་འཛུགས་སྐབས་སྒྲོག་ཆས་ཀྱི་གསལ་གཞིའི་སྟེང་དུ་སྟོན་ཡོད། {4}=LAN IP:མཐུད་ཁ། {5}=WAN IP:མཐུད་ཁ། UI སྐད་ཡིག་ལ་རྗེས་འཇུག་བྱེད་པར་སྔོན་སྒྲིག་བཞག་རོགས།",
