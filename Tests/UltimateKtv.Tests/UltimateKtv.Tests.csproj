<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x86;x64</Platforms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- 與 StyleSimulator/Updater 相同：直接連結主程式的原始檔，不參考整個 WPF 主程式 -->
  <ItemGroup>
    <Compile Include="..\..\Playback\*.cs" Link="Linked\Playback\%(Filename)%(Extension)" />
    <Compile Include="..\..\Infrastructure\AppLogger.cs" Link="Linked\Infrastructure\AppLogger.cs" />
    <Compile Include="..\..\Library\Db.cs" Link="Linked\Library\Db.cs" />
    <Compile Include="..\..\Library\DbHelper.cs" Link="Linked\Library\DbHelper.cs" />
    <Compile Include="..\..\Library\DataTableExtension.cs" Link="Linked\Library\DataTableExtension.cs" />
    <Compile Include="..\..\Library\SongLibrary.cs" Link="Linked\Library\SongLibrary.cs" />
    <Compile Include="..\..\Library\Song.cs" Link="Linked\Library\Song.cs" />
    <Compile Include="..\..\Library\SongQuery.cs" Link="Linked\Library\SongQuery.cs" />
    <Compile Include="..\..\Youtube\YoutubeVideoId.cs" Link="Linked\Youtube\YoutubeVideoId.cs" />
    <Compile Include="..\..\Youtube\YoutubeDownloadQueue.cs" Link="Linked\Youtube\YoutubeDownloadQueue.cs" />
    <Compile Include="..\..\Youtube\YoutubeFormat.cs" Link="Linked\Youtube\YoutubeFormat.cs" />
    <Compile Include="..\..\Settings\AppSettings.cs" Link="Linked\Settings\AppSettings.cs" />
    <Compile Include="..\..\Themes\ThemeSettings.cs" Link="Linked\Themes\ThemeSettings.cs" />
    <Compile Include="..\..\Settings\SettingsJson.cs" Link="Linked\Settings\SettingsJson.cs" />
    <Compile Include="..\..\Remote\WebCultureMatcher.cs" Link="Linked\Remote\WebCultureMatcher.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Data.OleDb" Version="10.0.13" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.4" />
    <!-- System.Data.SQLite 2.x 不附原生 e_sqlite3，測試用 SQLite 歌庫時另外帶入 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <!-- YoutubeFormat 的 YoutubeExplode 串流選擇與連網測試，版本與主程式相同 -->
    <PackageReference Include="YoutubeExplode" Version="6.6.2" />
  </ItemGroup>

</Project>
