<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x86;x64</Platforms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- 與 StyleSimulator/Updater 相同：直接連結主程式的原始檔，不參考整個 WPF 主程式 -->
  <ItemGroup>
    <Compile Include="..\..\Playback\*.cs" Link="Linked\Playback\%(Filename)%(Extension)" />
    <Compile Include="..\..\AppLogger.cs" Link="Linked\AppLogger.cs" />
    <Compile Include="..\..\Db.cs" Link="Linked\Db.cs" />
    <Compile Include="..\..\DbHelper.cs" Link="Linked\DbHelper.cs" />
    <Compile Include="..\..\DataTableExtension.cs" Link="Linked\DataTableExtension.cs" />
    <Compile Include="..\..\SongLibrary.cs" Link="Linked\SongLibrary.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.2" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.2" />
    <!-- System.Data.SQLite 2.x 不附原生 e_sqlite3，測試用 SQLite 歌庫時另外帶入 -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

</Project>
